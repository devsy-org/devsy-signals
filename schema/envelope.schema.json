{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devsy-org/devsy-signals/schema/envelope.schema.json",
  "title": "Devsy record envelope",
  "type": "object",
  "required": [
    "v",
    "kind",
    "ts",
    "src"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "kind": {
      "enum": [
        "log",
        "status",
        "result",
        "error",
        "audit"
      ]
    },
    "type": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "src": {
      "type": "string",
      "pattern": "^(cli|desktop|agent|controlplane|pool|provider/[a-z0-9][a-z0-9._-]*)$"
    },
    "level": {
      "enum": [
        "trace",
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "msg": {
      "type": "string",
      "minLength": 1
    },
    "traceId": {
      "$ref": "#/$defs/traceId"
    },
    "operationId": {
      "$ref": "#/$defs/spanId"
    },
    "parentOperationId": {
      "$ref": "#/$defs/spanId"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "pool": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "policyVersion": {
      "$ref": "#/$defs/versionHash"
    },
    "configVersion": {
      "$ref": "#/$defs/versionHash"
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "data": {
      "type": "object"
    },
    "attrs": {
      "$ref": "#/$defs/attrs"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": ["status", "result", "error"]
          }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "type": {
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "log"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "else": {
        "required": [
          "type",
          "id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "log",
              "status"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "level"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "log"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "msg"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "error"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "status",
              "result",
              "audit"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "data"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "audit"
            ]
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "$ref": "audit-data.schema.json",
        "required": [
          "id",
          "pool",
          "host",
          "policyVersion",
          "configVersion",
          "actor"
        ],
        "properties": {
          "msg": false,
          "level": false,
          "attrs": false,
          "type": {
            "$ref": "#/$defs/auditType"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "audit"
          },
          "type": {
            "not": {
              "enum": ["policy.apply", "pool.start"]
            }
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "session"
        ]
      }
    }
  ],
  "$defs": {
    "auditType": {
      "enum": [
        "session.request",
        "session.spawn",
        "session.ready",
        "session.start",
        "session.idle",
        "session.end",
        "session.reclaim",
        "policy.apply",
        "pool.start",
        "credential.issue",
        "credential.use",
        "credential.deny",
        "credential.revoke",
        "egress.deny",
        "egress.allow.summary",
        "egress.allow"
      ]
    },
    "auditGitRef": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[^/]+(/[^/]+)*$",
      "not": {
        "pattern": "[\\x00-\\x20\\x7f~^:?*\\[\\\\]|\\.\\.|@\\{|(^|/)\\.|\\.lock(/|$)|\\.$|^@$"
      }
    },
    "versionHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": {
        "const": "00000000000000000000000000000000"
      }
    },
    "spanId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "not": {
        "const": "0000000000000000"
      }
    },
    "actor": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "user",
            "agent",
            "adapter",
            "local_user",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "class",
        "retryable"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string"
        },
        "class": {
          "enum": [
            "internal",
            "usage",
            "config",
            "environment",
            "transient",
            "recoverable_build",
            "timeout",
            "canceled"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "attrScalar": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "attrs": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/attrScalar"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/$defs/attrScalar"
            }
          }
        ]
      }
    }
  }
}
